# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=appdb;Username=postgres;Password=yourpassword

# Auth (JWT Bearer — e.g. Auth0, Keycloak, Azure AD B2C)
JwtBearer__Authority=https://your-auth-provider/
JwtBearer__Audience=your-api-audience

# Environment
ASPNETCORE_ENVIRONMENT=Development
